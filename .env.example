# PRISM IDE Environment Configuration Template
# Copy this file to .env and configure your MySQL settings.
# NEVER commit .env to version control.

# Application
APP_NAME=PRISM IDE
ENVIRONMENT=development
DEBUG=True
STORAGE_BACKEND=mysql  # Options: 'mysql' (default) or 'memory' for offline testing

# Developer Session Management
SESSION_TIMEOUT_MINUTES=30
SESSION_HEARTBEAT_INTERVAL_SECONDS=60

# MySQL Primary Relational Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=prism_app
DB_PASSWORD=your_secure_password_here
DB_NAME=prism_ide
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=False

# Dedicated Test Database (Used for integration tests, never production)
TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_USER=prism_app
TEST_DB_PASSWORD=your_secure_password_here
TEST_DB_NAME=prism_test_db

# LLM Provider Configuration (Phase 20)
# Options: 'mock' (default for offline/testing), 'groq', 'openai', 'gemini'
LLM_PROVIDER=mock
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_FACTOR=1.5

# Provider API Credentials (Optional - configure according to chosen provider)
# NEVER commit real keys to version control!
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# RAG (Retrieval Augmented Generation) Configuration
RAG_ENABLED=True
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_STORAGE_PATH=.prism/rag_store.json
